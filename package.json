{
  "name": "hurricane-tracker-mcp",
  "version": "1.0.0",
  "description": "Production-grade MCP server providing real-time hurricane tracking, forecast cones, local alerts, and historical storm data through LLM-optimized tools",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "stdio": "MCP_TRANSPORT=stdio tsx src/server.ts",
    "http": "MCP_TRANSPORT=http tsx src/server.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:llm": "vitest run --config vitest.llm.config.ts",
    "lint": "eslint src/**/*.ts --no-warn-ignored",
    "lint:fix": "eslint src/**/*.ts --fix --no-warn-ignored",
    "security:check": "npm audit --audit-level=high",
    "validate": "npm run lint && npm run test && npm run security:check && npm run build",
    "health:check": "curl -f http://localhost:8080/health || exit 1"
  },
  "keywords": [
    "mcp",
    "hurricane",
    "weather",
    "tracking",
    "noaa",
    "nhc",
    "tropical",
    "storms",
    "ai",
    "llm"
  ],
  "author": "Hurricane Tracker MCP Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumaran-is/hurricane-tracker-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kumaran-is/hurricane-tracker-mcp/issues"
  },
  "homepage": "https://github.com/kumaran-is/hurricane-tracker-mcp#readme",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@modelcontextprotocol/sdk": "1.17.5",
    "dompurify": "3.2.0",
    "dotenv": "17.2.2",
    "fastify": "5.6.0",
    "lru-cache": "11.2.1",
    "p-queue": "8.0.1",
    "pino": "9.9.4",
    "rate-limiter-flexible": "5.0.3",
    "undici": "7.16.0",
    "uuid": "13.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/dompurify": "3.2.0",
    "@types/long": "5.0.0",
    "@types/lru-cache": "7.10.9",
    "@types/node": "22.0.0",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.43.0",
    "@typescript-eslint/parser": "8.43.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.35.0",
    "pino-pretty": "13.1.1",
    "supertest": "7.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
